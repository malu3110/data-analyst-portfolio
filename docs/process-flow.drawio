<mxfile host="app.diagrams.net"><diagram id="asis" name="As-Is (assumed)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="680"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="asis-title" value="AS-IS (assumed process, design exercise): crossing chosen from a single live snapshot" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1360" height="35" as="geometry"/></mxCell><mxCell id="asis-lane0" value="Customer (shipper)" style="swimlane;horizontal=0;startSize=140;html=1;fontSize=12;fillColor=#f5f5f5;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="1360" height="130" as="geometry"/></mxCell><mxCell id="asis-lane1" value="Dispatcher" style="swimlane;horizontal=0;startSize=140;html=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="180" width="1360" height="130" as="geometry"/></mxCell><mxCell id="asis-lane2" value="Driver" style="swimlane;horizontal=0;startSize=140;html=1;fontSize=12;fillColor=#f5f5f5;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="310" width="1360" height="130" as="geometry"/></mxCell><mxCell id="asis-lane3" value="CBP wait-time website" style="swimlane;horizontal=0;startSize=140;html=1;fontSize=12;fillColor=#ffffff;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="440" width="1360" height="130" as="geometry"/></mxCell><mxCell id="a1" value="Tender cross-border load with delivery window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="165.0" y="78.0" width="140" height="74" as="geometry"/></mxCell><mxCell id="a2" value="Assign driver; pick crossing (habitual default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335.0" y="208.0" width="14