# Copy to .env for local development (never commit .env).
DATABASE_URL=postgresql://dev:dev@localhost:5432/borderwaits
# dbt reads the PG* variables (scripts/env_from_url.py derives them from DATABASE_URL).
PGHOST=localhost
PGPORT=5432
PGUSER=dev
PGPASSWORD=dev
PGDATABASE=borderwaits
PGSSLMODE=prefer
